<configuration>
  <appSettings>
    <!-- SECURITY WARNING: Update this path to match your deployment environment -->
    <add key="Path" value="C:\Users\Wachira.Diloksumpan\source\repos\Coupon\Coupon\" />

    <!-- Optional: Path for error log files (defaults to App_Data/Logs if not specified) -->
    <add key="LogPath" value="" />

    <!-- Development mode - shows detailed error messages -->
    <add key="Environment" value="Development" />

    <!-- ================================================================= -->
    <!-- Authentication API Settings (Hybrid Authentication System)        -->
    <!-- ================================================================= -->
    <!-- IMPORTANT: Update AuthenApiBaseUrl with your actual API endpoint -->
    <add key="AuthenApiBaseUrl" value="https://authen.hondacx.me/api" />
    <!-- SECURITY CRITICAL: Set your API key here (or use environment variable) -->
    <add key="AuthenApiKey" value="" />
    <add key="AuthenApiTimeout" value="30" />

    <!-- Cache Settings -->
    <add key="CacheDurationDays" value="90" />
    <!-- SECURITY CRITICAL: Change this to a unique random string for your installation -->
    <add key="PasswordSalt" value="HondaCX_2024_CHANGE_THIS_TO_UNIQUE_VALUE" />

    <!-- Security Settings -->
    <add key="MaxFailedAttempts" value="5" />
    <add key="LockoutDurationMinutes" value="15" />
    <add key="SessionTimeoutHours" value="8" />
    <!-- ================================================================= -->

    <!-- Database Type: "mssql" for SQL Server or "postgresql" for PostgreSQL -->
    <add key="DatabaseType" value="mssql" />

    <!-- SECURITY CRITICAL: DO NOT commit real credentials to version control!
         PRODUCTION DEPLOYMENT: Move these credentials to:
         1. Azure Key Vault (recommended for Azure)
         2. AWS Secrets Manager (recommended for AWS)
         3. Environment variables
         4. Encrypted configuration sections

         Current credentials are EXPOSED and should be changed immediately:
         - MSSQL: admin / Racc00n@@306 @ 192.168.80.31
         - PostgreSQL: postgres / Spider@@306 @ 192.168.80.31
    -->
	  <add key="MSSQLConnectionString" value="Data Source=192.168.80.31;Initial Catalog=Coupon_Honda;User ID=admin;Password=Racc00n@@306"/>
	  <add key="PostgreSQLConnectionString" value="Host=192.168.80.31;Port=5432;Database=Coupon_Honda;User Id=postgres;Password=Spider@@306;"/>

	  <add key="Coupon_DatabaseName" value="Coupon_Honda" />
	  <add key="CutSlashfromRedirect" value="no" />
	  <add key="NumberofCode" value="4" />

	  <!-- SECURITY WARNING: Admin emails and passwords should be moved to secure storage
	       Consider implementing proper authentication using ASP.NET Identity -->
	  <add key="ReportPassword" value="Wachira.Diloksumpan@ipsos.com;muslin.ridhrod@ipsos.com;waraporn.kunaboot@ipsos.com,ashwin.kwatra@ipsos.com" />
	  <add key="LDAP" value="10.137.157.210" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="10240" executionTimeout="90" enableVersionHeader="false" />

    <!-- SECURITY: Session configuration -->
    <sessionState mode="InProc" timeout="30" cookieName="CouponSession" cookieless="UseCookies" regenerateExpiredSessionId="true">
      <!-- NOTE: For production, consider using SQL Server or Redis for session state -->
    </sessionState>

    <!-- SECURITY: Authentication settings -->
    <authentication mode="Forms">
      <forms loginUrl="~/Admin/Report.aspx" timeout="30" slidingExpiration="true" requireSSL="true" cookieless="UseCookies" />
    </authentication>

    <!-- SECURITY: Custom errors for production -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx">
      <error statusCode="403" redirect="~/Error.aspx" />
      <error statusCode="404" redirect="~/Error.aspx" />
    </customErrors>

    <pages>
      <namespaces>
        <add namespace="System.Web.Optimization" />
      </namespaces>
      <controls>
        <add assembly="Microsoft.AspNet.Web.Optimization.WebForms" namespace="Microsoft.AspNet.Web.Optimization.WebForms" tagPrefix="webopt" />
      </controls>
    </pages>

    <!-- SECURITY: Disable tracing in production -->
    <trace enabled="false" localOnly="true" />

    <!-- SECURITY: Disable debug compilation in production -->
    <!-- Change debug="false" before deploying to production -->
  </system.web>
