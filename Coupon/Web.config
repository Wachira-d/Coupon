  <!-- SECURITY: IIS-specific security settings -->
  <system.webServer>
    <!-- SECURITY: Remove server information headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
      </customHeaders>
    </httpProtocol>

    <!-- SECURITY: Request filtering -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
        <!-- 10 MB max request size -->
      </requestFiltering>
    </security>

    <!-- SECURITY: Remove Server header (IIS 10+ only) -->
    <!-- Note: removeServerHeader attribute requires IIS 10.0 or later -->
    <!-- For IIS 7.5-8.5, use URL Rewrite module or registry to remove Server header -->

    <!-- SECURITY: HTTPS enforcement via URL Rewrite -->
    <!-- NOTE: Uncomment this section in production to enforce HTTPS -->
